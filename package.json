{
	"name": "aio",
	"version": "0.6.0",
	"description": "Combined Pi extension for structured questions, permission modes, subagents, enhanced tools and diffs, shell rewriting, structural search, and self-hosted web browsing.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"questionnaire",
		"clarifying-questions",
		"clipboard",
		"effort",
		"thinking",
		"permission-modes",
		"subagents",
		"delegation",
		"parallel-agents",
		"syntax-highlighting",
		"pretty-print",
		"fff",
		"diff",
		"word-diff",
		"rtk",
		"token-optimization",
		"shell-rewrite",
		"ast-grep",
		"structural-search",
		"syntax-aware-search",
		"codemod",
		"web-search",
		"searxng",
		"camofox",
		"cloakbrowser"
	],
	"files": [
		"index.ts",
		"ask-user-question/**/*",
		"!ask-user-question/**/*.test.ts",
		"!ask-user-question/test-fixtures.ts",
		"!ask-user-question/test-utils.ts",
		"copy-widget/**/*.ts",
		"!copy-widget/**/*.test.ts",
		"diff-tools/**/*.ts",
		"!diff-tools/**/*.test.ts",
		"diff-tools/CONFIG.md",
		"diff-tools/LICENSE",
		"effort/**/*.ts",
		"init/**/*.ts",
		"!init/**/*.test.ts",
		"permission-modes/**/*.ts",
		"!permission-modes/**/*.test.ts",
		"pretty-tools/**/*.ts",
		"!pretty-tools/**/*.test.ts",
		"pretty-tools/LICENSE",
		"rtk/**/*.ts",
		"!rtk/**/*.test.ts",
		"subagents/**/*.ts",
		"subagents/agents/**/*.md",
		"!subagents/**/*.test.ts",
		"browser-search/**/*.ts",
		"!browser-search/**/*.test.ts",
		"browser-search/README.md",
		"browser-search/LICENSE",
		"user-bash/**/*.ts",
		"!user-bash/**/*.test.ts",
		"ast-grep/**/*.ts",
		"!ast-grep/**/*.test.ts",
		"README.md"
	],
	"scripts": {
		"test": "npm run test:node && npm run test:diff && npm run test:upstream",
		"test:diff": "vitest run --config vitest.diff.config.ts",
		"test:node": "tsx --test ast-grep/*.test.ts browser-search/*.test.ts copy-widget/*.test.ts init/*.test.ts permission-modes/*.test.ts pretty-tools/*.test.ts rtk/*.test.ts subagents/*.test.ts user-bash/*.test.ts ask-user-question/registration.test.ts ask-user-question/rpc-fallback.test.ts ask-user-question/tool/questionnaire.test.ts",
		"test:upstream": "vitest run --config vitest.config.ts"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@ast-grep/cli": "0.43.0",
		"@ff-labs/fff-node": "^0.10.0",
		"@juicesharp/rpiv-config": "2.0.0",
		"@mozilla/readability": "^0.6.0",
		"@shikijs/cli": "4.0.2",
		"diff": "^7.0.0",
		"linkedom": "^0.18.0",
		"marked": "18.0.5",
		"shiki": "4.0.2",
		"turndown": "^7.2.0",
		"xxhash-wasm": "^1.1.0",
		"typebox": "^1.1.24",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "0.80.10",
		"@earendil-works/pi-ai": "0.80.10",
		"@earendil-works/pi-coding-agent": "0.80.10",
		"@earendil-works/pi-tui": "0.80.10",
		"@types/diff": "^7.0.2",
		"tsx": "4.20.6",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@juicesharp/rpiv-i18n": "*"
	},
	"peerDependenciesMeta": {
		"@juicesharp/rpiv-i18n": {
			"optional": true
		}
	},
	"optionalDependencies": {
		"cloakbrowser": "0.5.1",
		"playwright-core": "1.60.0"
	}
}
