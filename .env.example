# Optional image overrides
# Built locally from docker/searxng/Dockerfile (includes JSON search format).
SEARXNG_IMAGE=pi-aio-searxng:local
CAMOFOX_IMAGE=ghcr.io/jo-inc/camofox-browser:1.13.0

# Generate with: openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-random-secret

# Optional; leave empty for a localhost-only Camofox instance.
CAMOFOX_API_KEY=
